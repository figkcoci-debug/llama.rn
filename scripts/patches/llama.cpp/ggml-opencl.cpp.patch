+    {
+        const char * adreno_kernels_env = getenv("GGML_OPENCL_ADRENO_KERNELS");
+        if (adreno_kernels_env != nullptr && adreno_kernels_env[0] == '0') {
+            return false;
+        }
+    }
+    // Per-type off switches inside the family, same rationale: the weight layout is
