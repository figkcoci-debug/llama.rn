+        }
+        const char * q6k_kernels_env = getenv("GGML_OPENCL_Q6K_KERNELS");
+        if (q6k_kernels_env != nullptr && q6k_kernels_env[0] == '0' &&
+            tensor->type == GGML_TYPE_Q6_K) {
+            return false;
+        }
+    }
